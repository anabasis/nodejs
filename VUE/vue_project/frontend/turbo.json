{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalDotEnv": [".env.local", ".env"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "out/**"],
      "outputMode": "errors-only"
    },
    "lint": {
      "outputMode": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": false
    },
    "clean": {
      "cache": false
    }
  }
}
