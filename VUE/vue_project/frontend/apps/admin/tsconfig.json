{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": "./",
    "paths": {
      "@components/*": ["components/*"],
      "@ui/*": ["../../packages/ui/*"],
      "@type/*": ["lib/type/*"],
      "@hook/*": ["lib/hook/*"],
      "@util/*": ["lib/util/*"],
      "@store/*": ["lib/store/*"],
      "@constant/*": ["lib/constant/*"],
      "@schema/*": ["lib/schema/*"],
      "@api/*": ["lib/api/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
